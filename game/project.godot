; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Membrana (fanmade, não oficial)"
config/description="RPG de fã, gratuito e não oficial, no estilo For The King, publicado sob a Licença da Comunidade de Ordem Paranormal."
run/main_scene="res://scenes/titulo.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

Jogo="*res://scripts/core/jogo.gd"

[dotnet]

project/assembly_name="Ordem Paranormal- Fanmade (WIP)"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/fallback="pt_BR"
